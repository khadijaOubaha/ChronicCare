
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Measurement Abnormal Event",
  "description": "Contrat d'événement envoyé par Mesures à Reminders lorsqu'une anomalie de surveillance est détectée.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "event_version",
    "event_id",
    "occurred_at",
    "patient_id",
    "doctor_id",
    "data"
  ],
  "properties": {
    "event_type": {
      "const": "measurement.abnormal"
    },
    "event_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "patient_id": {
      "type": "string",
      "format": "uuid"
    },
    "doctor_id": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient",
        "measurement",
        "anomalies"
      ],
      "properties": {
        "patient": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "full_name",
            "disease_type"
          ],
          "properties": {
            "full_name": {
              "type": "string"
            },
            "disease_type": {
              "type": "string"
            }
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "measurement_id",
            "measurement_type",
            "value",
            "secondary_value",
            "unit",
            "measured_at"
          ],
          "properties": {
            "measurement_id": {
              "type": "string",
              "format": "uuid"
            },
            "measurement_type": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "secondary_value": {
              "type": ["number", "null"]
            },
            "unit": {
              "type": "string"
            },
            "measured_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "anomalies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_code",
              "direction",
              "message"
            ],
            "properties": {
              "rule_code": {
                "type": "string"
              },
              "direction": {
                "enum": ["low", "high"]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
